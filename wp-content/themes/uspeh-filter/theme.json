{
    "$schema": "https://schemas.wp.org/wp/6.0/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                { "slug": "primary", "color": "#00639E", "name": "Основен син" },
                { "slug": "primary-dark", "color": "#052C4B", "name": "Тъмносин" },
                { "slug": "primary-light", "color": "#3AA3DC", "name": "Светлосин" },
                { "slug": "accent", "color": "#E85D2C", "name": "Акцент оранжев" },
                { "slug": "accent-light", "color": "#FF6B35", "name": "Светъл акцент" },
                { "slug": "cta", "color": "#E31C23", "name": "CTA червен" },
                { "slug": "base", "color": "#FFFFFF", "name": "Бял фон" },
                { "slug": "base-alt", "color": "#F7F7F7", "name": "Сив фон" },
                { "slug": "contrast", "color": "#052C4B", "name": "Тъмен фон" },
                { "slug": "ink", "color": "#4A4A4A", "name": "Текст" },
                { "slug": "text-light", "color": "#595959", "name": "Светъл текст" },
                { "slug": "hairline", "color": "#E8E8E8", "name": "Бордюр" },
                { "slug": "success", "color": "#2E7D32", "name": "Успех" },
                { "slug": "error", "color": "#D32F2F", "name": "Грешка" }
            ],
            "gradients": [
                {
                    "slug": "accent-cta",
                    "gradient": "linear-gradient(135deg, #E85D2C 0%, #E31C23 100%)",
                    "name": "Оранжево към червено"
                },
                {
                    "slug": "navy-overlay",
                    "gradient": "linear-gradient(100deg, rgba(5,44,75,0.85) 0%, rgba(0,99,158,0.45) 100%)",
                    "name": "Тъмносиньо покритие"
                }
            ]
        },
        "typography": {
            "fluid": false,
            "fontFamilies": [
                {
                    "slug": "body",
                    "name": "Source Sans 3 (основен)",
                    "fontFamily": "'Source Sans 3', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
                },
                {
                    "slug": "display",
                    "name": "Montserrat (заглавия)",
                    "fontFamily": "'Montserrat', sans-serif"
                },
                {
                    "slug": "script",
                    "name": "Dancing Script (акцент)",
                    "fontFamily": "'Dancing Script', cursive"
                }
            ],
            "fontSizes": [
                { "slug": "small", "size": "0.875rem", "name": "Малък" },
                { "slug": "medium", "size": "1rem", "name": "Среден" },
                { "slug": "large", "size": "clamp(1.1rem, 2.5vw, 1.5rem)", "name": "Голям" },
                { "slug": "x-large", "size": "clamp(1.45rem, 3vw, 2.4rem)", "name": "Много голям" },
                { "slug": "xx-large", "size": "clamp(1.75rem, 4vw, 2.85rem)", "name": "Огромен" }
            ]
        },
        "spacing": {
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": ["px", "em", "rem", "vw", "vh", "%"],
            "spacingSizes": [
                { "slug": "10", "size": "0.5rem", "name": "1" },
                { "slug": "20", "size": "1rem", "name": "2" },
                { "slug": "30", "size": "1.5rem", "name": "3" },
                { "slug": "40", "size": "2.5rem", "name": "4" },
                { "slug": "50", "size": "4rem", "name": "5" },
                { "slug": "60", "size": "clamp(3rem, 6vw, 5.5rem)", "name": "6 (секция)" }
            ]
        },
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1400px"
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "1rem",
            "lineHeight": "1.6"
        },
        "elements": {
            "link": {
                "color": { "text": "var(--wp--preset--color--primary)" },
                ":hover": {
                    "color": { "text": "var(--wp--preset--color--accent)" }
                },
                "typography": { "textDecoration": "none" }
            },
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontWeight": "600",
                    "lineHeight": "1.2",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.04em"
                },
                "color": { "text": "var(--wp--preset--color--primary-dark)" }
            },
            "h1": {
                "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" },
                "color": { "text": "var(--wp--preset--color--primary)" }
            },
            "h2": {
                "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
            },
            "h3": {
                "typography": { "fontSize": "var(--wp--preset--font-size--large)" }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--accent)",
                    "text": "#FFFFFF"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "0.85rem",
                    "fontWeight": "600",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.06em"
                },
                "border": { "radius": "0px" },
                "spacing": {
                    "padding": {
                        "top": "0.85rem",
                        "right": "2rem",
                        "bottom": "0.85rem",
                        "left": "2rem"
                    }
                },
                ":hover": {
                    "color": {
                        "background": "#C94A1A",
                        "text": "#FFFFFF"
                    }
                }
            }
        }
    }
}
